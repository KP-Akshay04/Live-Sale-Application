# Environment Variables Configuration
# Copy this file to .env in local development and provide actual values.
# NEVER commit actual secrets, passwords, or production credentials.

# Application Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MySQL Database Connection (Prisma URL Format)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=public
DATABASE_URL="mysql://YOUR_USER:YOUR_PASSWORD@localhost:3306/bindu_live_sale"
